# ─── Auth ──────────────────────────────────────────────────────────────────
# Shared secret with creative-studio's FFMPEG_SERVICE_TOKEN.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

# ─── Storage (Supabase Storage, S3-compatible) ─────────────────────────────
# Endpoint / region / keys: Supabase Dashboard → Storage → Settings → S3 access keys.
STORAGE_ENDPOINT=https://klolxchomofbfwwnmbdy.storage.supabase.co/storage/v1/s3
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=media
# MUST match creative-studio's lib/creative/storage.ts:publicBase() exactly.
STORAGE_PUBLIC_URL=https://klolxchomofbfwwnmbdy.supabase.co/storage/v1/object/public/media

# ─── Network ───────────────────────────────────────────────────────────────
PORT=3000
# Keep on loopback; nginx terminates TLS and proxies. 0.0.0.0 exposes the
# service to the public internet with only the bearer token in front of it.
LISTEN_HOST=127.0.0.1

# ─── Download safety ───────────────────────────────────────────────────────
# Leave EMPTY in production. The service downloads clips straight from the
# Kling / kie CDNs, whose hostnames are provider-controlled and change without
# notice — an allowlist here silently breaks /merge. The private-IP block in
# validation.js is the safety net that actually matters.
ALLOWED_DOWNLOAD_HOSTS=
# http:// downloads — local development only.
ALLOW_HTTP_DOWNLOADS=false

# ─── Subtitle fallback (optional) ──────────────────────────────────────────
# Cloudflare Workers AI Whisper, used by /burn-subs only when the caller sends
# no `words`. creative-studio supplies words from the TTS bake (global_vo) or
# ElevenLabs Scribe (global_native / custom); this is the third line of defence.
# Unset → /burn-subs returns subtitles:false, and the executor fails the run.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
